<mujoco model="shared_table_block_scene">
  <statistic center="0.2 0 0.95" extent="1.4"/>
  <size nconmax="512" njmax="1024"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"
    />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.38 0.24 1"/>
    <material name="block_mat" rgba="0.85 0.2 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="table_scene" pos="0.48 0 0.575">
      <geom name="table_top" type="box" size="0.34 0.42 0.025" material="table_mat" friction="1.2 0.02 0.002"/>
      <geom name="table_leg_fl" type="box" pos="0.27 0.35 -0.575" size="0.03 0.03 0.575" material="table_mat"/>
      <geom name="table_leg_fr" type="box" pos="0.27 -0.35 -0.575" size="0.03 0.03 0.575" material="table_mat"/>
      <geom name="table_leg_rl" type="box" pos="-0.27 0.35 -0.575" size="0.03 0.03 0.575" material="table_mat"/>
      <geom name="table_leg_rr" type="box" pos="-0.27 -0.35 -0.575" size="0.03 0.03 0.575" material="table_mat"/>
    </body>

    <!-- Cube half-size 0.015 → 30mm edge; center z = table_top(0.60) + half_z so it rests on table -->
    <body name="block" pos="0.48 0 0.615">
      <freejoint/>
      <geom
        name="block_geom"
        type="box"
        size="0.015 0.015 0.015"
        material="block_mat"
        density="300"
        condim="6"
        friction="3 0.15 0.02"
        solimp="0.95 0.99 0.001 0.5 2"
        solref="0.002 1"
      />
    </body>

    <camera mode="fixed" name="frontview" pos="2.304 -0.014 1.620" xyaxes="0.006 1.000 -0.000 -0.575 0.004 0.818"/>
    <camera mode="fixed" name="birdview" pos="-0.2 0 3.0" quat="0.7071 0 0 0.7071"/>
    <camera mode="fixed" name="overview" pos="0.289 0.001 1.993" xyaxes="0.003 -1.000 -0.000 1.000 0.003 0.017"/>
    <camera mode="fixed" name="agentview" pos="0.5 0 1.35" quat="0.653 0.271 0.271 0.653"/>
    <camera mode="fixed" name="sideview" pos="1.614 1.178 1.000" xyaxes="-0.704 0.710 -0.000 -0.212 -0.210 0.955"/>
  </worldbody>
</mujoco>
